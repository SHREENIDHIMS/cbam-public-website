# Copy to .env.local for local development. Every variable is documented here.
# Defaults shown are used when the variable is unset.

# --- Public (safe in the browser) ---

# Canonical origin used for canonical URLs, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# production | preview | development. Anything other than production sends noindex everywhere.
NEXT_PUBLIC_SITE_ENV=development

# Origin of the existing CBAM application, used for hand-off links (sign in, create workspace,
# dashboard). Unset in development renders "Workspace link to be confirmed".
# Required (build fails without it) when NEXT_PUBLIC_SITE_ENV=production.
NEXT_PUBLIC_CBAM_APP_URL=

# Paths on the existing application. Unknown until the app contract is confirmed.
NEXT_PUBLIC_CBAM_SIGN_IN_PATH=/
NEXT_PUBLIC_CBAM_CREATE_WORKSPACE_PATH=/
NEXT_PUBLIC_CBAM_DASHBOARD_PATH=/

# true logs analytics events to the browser console in development.
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# --- Server only (never prefix with NEXT_PUBLIC_) ---

# fixture | live. Server-only despite the name. Live never falls back to fixtures.
PUBLIC_API_MODE=fixture

# Base URL of the existing CBAM backend. Required when PUBLIC_API_MODE=live (https in production).
CBAM_API_URL=

# Credential for the backend, if one is required. Optional.
CBAM_API_KEY=

# Timeout for backend calls in milliseconds (integer, 1000 to 30000).
CBAM_API_TIMEOUT_MS=10000

# true disables the in-memory rate limiter. End-to-end tests only.
RATE_LIMIT_DISABLED=false
